# HMXTECH website: production settings for the cPanel server.
# Copy to .env on the server, fill in every value marked <...>, then run:
#   php artisan key:generate   (first deploy only, if APP_KEY is empty)

APP_NAME=HMXTECH
APP_ENV=production
APP_KEY=
APP_DEBUG=false
DEBUGBAR_ENABLED=false
APP_URL=https://hmxtech.co.tz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Control panel users are stored in MySQL (cPanel → MySQL Databases).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpanel-database-name>
DB_USERNAME=<cpanel-database-user>
DB_PASSWORD=<database-password>

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Quote requests and newsletter sign-ups are emailed to info@hmxtech.co.tz.
# Use the cPanel mailbox (cPanel → Email Accounts → Connect Devices).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<mail.hmxtech.co.tz>
MAIL_PORT=465
MAIL_USERNAME=info@hmxtech.co.tz
MAIL_PASSWORD=<mailbox-password>
MAIL_FROM_ADDRESS="info@hmxtech.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

# Statamic Pro is needed for more than one control panel user and the custom
# control panel logo. Buy a licence at statamic.com and paste the key here.
STATAMIC_LICENSE_KEY=<statamic-license-key>
STATAMIC_PRO_ENABLED=true
STATAMIC_CUSTOM_LOGO_URL=/hmxtech/brand/logo-color.svg
STATAMIC_CUSTOM_DARK_LOGO_URL=/hmxtech/brand/logo-for-dark-bg.svg
STATAMIC_CUSTOM_FAVICON_URL=/hmxtech/brand/favicon.svg
STATAMIC_STACHE_WATCHER=false
STATAMIC_STATIC_CACHING_STRATEGY=null
